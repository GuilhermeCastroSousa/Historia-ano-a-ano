# ─── Segredos ────────────────────────────────────────────────────────
# A chave da API vive fora do projeto (~/.chaves/youtube.txt).
# Estas linhas são um cinto de segurança, caso alguma cópia apareça aqui.
chave.txt
*.key
.env

# Credenciais OAuth do subir_playlist.py — vivem em ~/.chaves/, mas o mesmo
# cinto de segurança vale aqui caso alguma cópia apareça no projeto.
client_secret*.json
token-youtube.json

# ─── Gerado automaticamente ──────────────────────────────────────────
backups/
__pycache__/
*.pyc

# ─── Local da máquina, não do projeto ────────────────────────────────
.claude/settings.local.json
desktop.ini
Thumbs.db

# ─── Arquivos temporários do Excel (o "~$" de planilha aberta) ───────
~$*.xlsx
